{
  "name": "jobs.config",
  "description": "Interactive builder and validator for Velo job scheduler configuration files",
  "version": "2.0.0",
  "main": "src/index.html",
  "type": "module",
  "packageManager": "^npm@11.4.2",
  "scripts": {
    "start": "webpack serve --env NODE_ENV=development",
    "build": "webpack build --env NODE_ENV=production",
    "lint": "eslint src && stylelint 'src/**/*.css'",
    "test": "node --experimental-specifier-resolution=node --loader @swc-node/register/esm --test src/**/*.spec.ts",
    "serve": "python3 -m http.server -d dist"
  },
  "dependencies": {
    "cron-validator": "^1.4.0",
    "cronstrue": "^3.24.0",
    "parse-json": "^8.3.0",
    "preact": "^10.29.8",
    "react-hint": "^3.2.1",
    "strip-json-comments": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/css-modules": "^1.0.5",
    "@types/node": "^26.2.0",
    "@types/react-hint": "^3.2.4",
    "@types/wicg-file-system-access": "^2023.10.7",
    "autoprefixer": "^10.5.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.3",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "css-mqpacker-webpack-plugin": "^0.16.2",
    "eslint": "^10.9.0",
